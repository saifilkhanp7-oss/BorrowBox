{
  "name": "borrowbox",
  "private": true,
  "version": "2.0.0",
  "description": "BorrowBox – borrow and lend things inside small groups. Runs on Vercel (website + API) with Supabase (database).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vercel-build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "build": "npm --prefix client run build",
    "dev": "node --watch server/local.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/local.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
