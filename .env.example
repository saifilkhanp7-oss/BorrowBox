# Copy to .env for running on your own computer. On Vercel, set these in
# Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
# Leave empty on your computer to use a built-in local database instead.
DATABASE_URL=

# A long random text. Vercel Cron sends it automatically; it protects /api/cron.
CRON_SECRET=

# Same Google Apps Script email sender you use for Chronos.
# Without these, login codes are printed in the server log (and shown on screen locally).
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Optional: your site address for links in emails and QR codes.
# On Vercel it is filled in automatically from your production domain.
APP_URL=

# Time zone for due dates and 9 AM reminders
APP_TZ=Asia/Kolkata

# Max login codes per hour from one network (college Wi-Fi shares one IP)
AUTH_IP_LIMIT=60

# How long a device stays logged in (days)
SESSION_DAYS=365

# Only for testing a live site without email: shows the login code on screen. Never leave on.
OTP_DEMO_MODE=false

# Local only
PORT=4000
